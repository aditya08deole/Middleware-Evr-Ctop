# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Database Configuration
# Set USE_FIREBASE=true to use Firestore + the local SQLite mirror cache
# (this is what real deployments run — it's also the only mode with EMQX/
# MQTT support). Set to false only for a pure-SQLite dev/test run with no
# Firebase project and no EMQX devices.
USE_FIREBASE=true
DATABASE_URL=sqlite:///ctop_iot.db

# Firebase Configuration (required if USE_FIREBASE=true)
FIREBASE_CREDENTIALS_PATH=path/to/service-account-key.json
FIREBASE_PROJECT_ID=your-project-id

# Scheduler
SCHEDULER_INTERVAL_MINUTES=5

# EMQX / MQTT
# Namespace for this instance's MQTT client IDs. Leave unset in the real
# deployment. Set it to anything distinct (e.g. local-dev) before running a
# SECOND instance — typically app.py on a laptop while the deployed one is
# live. MQTT client IDs must be unique broker-wide, and because they are
# derived from the device ID they are otherwise identical across instances:
# both instances then kick each other off every few seconds on every EMQX
# device ("Unexpected disconnect (rc=128)"), dropping telemetry on the
# deployed instance too.
# EMQX_CLIENT_ID_PREFIX=local-dev

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT=json  # uncomment for structured JSON logs (one object per line)
                   # instead of plain text — useful once log volume is high
                   # enough that grepping plain text stops scaling. Default
                   # (unset, or "text") is unchanged plain-text output.
